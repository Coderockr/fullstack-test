APP_NAME="Investment Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# SPA origin — used for CORS allow-list and links in notification e-mails.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (PostgreSQL) -------------------------------------------------
# DB_HOST is the docker-compose service name, not localhost.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=investments
DB_USERNAME=investments
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Mail (Mailpit in dev — catches everything, never really sends) --------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@investments.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Investment domain rules (overridable) ---------------------------------
INVESTMENT_MONTHLY_RATE=0.0052
INVESTMENT_CURRENCY=BRL
